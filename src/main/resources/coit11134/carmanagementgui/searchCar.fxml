<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coit11134.carmanagementgui.SearchCarController">
   <children>
      <Label layoutX="180.0" layoutY="30.0" text="Search for a Car">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <Label layoutX="60.0" layoutY="90.0" text="Enter Car ID:" />
      <TextField fx:id="txtSearchID" layoutX="180.0" layoutY="85.0" prefWidth="200.0"/>
      <Button text="Search" layoutX="400.0" layoutY="85.0" onAction="#searchCarAction"/>
      <TextArea fx:id="txtResult" layoutX="60.0" layoutY="140.0" prefHeight="150.0" prefWidth="480.0"/>
      <Button fx:id="btnExit" layoutX="260.0" layoutY="320.0" text="Exit Search" onAction="#exitAction"/>
   </children>
</AnchorPane>