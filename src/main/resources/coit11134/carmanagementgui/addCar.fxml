<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coit11134.carmanagementgui.AddCarController">
   <children>
      <Label layoutX="200.0" layoutY="20.0" text="Add New Car" textFill="#1a73e8">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <GridPane layoutX="50.0" layoutY="60.0" hgap="10" vgap="10">
         <children>
            <Label text="Car ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCarID" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Brand:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtBrand" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Model:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtModel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Year:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtYear" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Price:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPrice" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Category:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1">
                <children>
                    <RadioButton fx:id="rbNew" text="New" toggleGroup="$category"/>
                    <RadioButton fx:id="rbUsed" text="Used" toggleGroup="$category"/>
                </children>
            </HBox>
         </children>
      </GridPane>
      <Button fx:id="btnSubmit" layoutX="70.0" layoutY="320.0" text="Submit" onAction="#submitAction"/>
      <Button fx:id="btnReset" layoutX="250.0" layoutY="320.0" text="Reset" onAction="#resetAction"/>
      <Button fx:id="btnCancel" layoutX="430.0" layoutY="320.0" text="Cancel" onAction="#cancelAction"/>
   </children>
</AnchorPane>